# ---- Slack (Socket Mode) ----
# Bot token from your Slack app (xoxb-...)
SLACK_BOT_TOKEN=xoxb-REPLACE-ME
# App-level token with connections:write (xapp-...)
SLACK_APP_TOKEN=xapp-REPLACE-ME

# ---- OpenShell gateway endpoint ----
# Single-host install:  127.0.0.1:17670  (mTLS)
# Docker/Helm/K8s:      <host>:8080      (TLS at Envoy/GRPCRoute or SPIFFE; bearer)
OPENSHELL_GATEWAY_URL=127.0.0.1:17670

# Auth mode: "mtls" (single-host default) or "bearer" (OIDC JWT, K8s)
OPENSHELL_AUTH_MODE=mtls

# TLS on the wire (true for both mTLS and bearer-over-TLS; false only for the local mock)
OPENSHELL_USE_TLS=true

# ---- mTLS bundle (single-host); default paths from install.sh ----
OPENSHELL_CA_CERT=${HOME}/.config/openshell/gateways/openshell/mtls/ca.crt
OPENSHELL_CLIENT_CERT=${HOME}/.config/openshell/gateways/openshell/mtls/tls.crt
OPENSHELL_CLIENT_KEY=${HOME}/.config/openshell/gateways/openshell/mtls/tls.key
# Overrides the TLS SNI / target name when the cert CN differs from the dial host
OPENSHELL_SERVER_NAME=localhost

# ---- Bearer auth (OPENSHELL_AUTH_MODE=bearer) ----
# Provide the token inline OR point at a file that holds it (file wins if set).
OPENSHELL_BEARER_TOKEN=
OPENSHELL_BEARER_TOKEN_FILE=

# ---- Bridge behavior ----
# Default OpenShell workspace when a sandbox/request does not specify one
OPENSHELL_WORKSPACE=default
# Poll interval for draft-policy discovery (ms). No push exists, so polling is mandatory.
POLL_INTERVAL_MS=3000
# Max GetDraftPolicy RPCs issued in parallel per poll cycle. Each cycle fetches one
# draft per sandbox; raising this keeps the per-cycle wall-clock flat as the sandbox
# count grows. Default 25; clamped to a minimum of 1.
POLL_CONCURRENCY=25
# Optional per-sandbox status observation via WatchSandbox: "off" or "observe"
WATCH_MODE=off
# Path to the durable bridge-owned state store (chunk_id -> message coords + tokens)
STATE_STORE_PATH=./state/bridge-state.json
# Optional retention for decided/closed records. Unset = keep forever (default). Set to
# a positive number of days (e.g. 30) to prune terminal records older than that at
# startup and periodically, bounding the state file's growth. Pending records are never
# pruned. A restart still rebuilds pending state from OpenShell, so only decision history
# older than the window is lost.
# STATE_RETENTION_DAYS=30
# Path to the YAML config (admins + routing)
CONFIG_PATH=./config/admins.yaml

# ---- Audit capture ----
# Capture ALL OpenShell audit events. This runs as a SEPARATE process
# (npm run start:capture), independent of the approve/reject bridge, and does NO
# dedup: it is a firehose, and an approval-outcome event that also appears here is
# acceptable. It does TWO things with each event:
#   1. ALWAYS accumulates activity counts into an audit-summary file the bridge
#      reads to render App Home charts (top sandboxes by activity + daily volume).
#      This is on whenever a source is set; it needs no Slack channel.
#   2. OPT-IN: also posts a card per event to a private Slack channel, but only
#      when routing.audit_channel is set in the YAML config (see below).
#
# CAPTURE_SOURCES selects the ingestion source(s), comma-separated. Empty = off.
#   file = tail the OCSF JSONL file OpenShell writes locally (the native path;
#          OpenShell emits OCSF as line-delimited JSON to a rolling file that
#          external tooling ships onward). No auth; the sink must be able to read
#          the file (co-located, mounted volume, or an aggregated copy).
#   http = run an inbound receiver that an external log-shipper (Filebeat/Vector)
#          POSTs to. Auth is a shared bearer we require (below).
# Examples:  CAPTURE_SOURCES=file   |   CAPTURE_SOURCES=http   |   CAPTURE_SOURCES=file,http
CAPTURE_SOURCES=
# The audit channel is OPTIONAL and set in the YAML config (routing.audit_channel);
# setting it opts INTO posting the firehose to Slack and it must differ from every
# approval channel. Leave it unset to capture to the summary file only (no posts).

# Where the capture process writes the audit-activity summary and the bridge reads
# it to render App Home charts. BOTH processes resolve this (it is not tied to
# CAPTURE_SOURCES); point them at the same path. Defaults to ./state/audit-summary.json.
CAPTURE_SUMMARY_STATE=./state/audit-summary.json

# ---- file source (CAPTURE_SOURCES includes "file") ----
# Path (or glob) to OpenShell's OCSF JSONL file(s). Required for the file source.
# OpenShell's default is a daily-rotated /var/log/openshell-ocsf.YYYY-MM-DD.log,
# so a glob is usually what you want. Point this at wherever the sink can read it.
CAPTURE_FILE_PATH=/var/log/openshell-ocsf.*.log
# Where the tailer persists per-file byte offsets so restarts resume cleanly.
CAPTURE_FILE_OFFSET_STATE=./state/capture-offsets.json

# ---- http source (CAPTURE_SOURCES includes "http") ----
# Address the receiver binds for the log-shipper's POSTs (NDJSON of bare OCSF by
# default; a JSON array or CloudEvents body is also accepted).
CAPTURE_RECEIVER_BIND=0.0.0.0:8090
# Shared bearer the shipper must present. Provide inline OR via a file (file wins
# if set). Keep the real value out of committed files; supply it in the env.
CAPTURE_RECEIVER_TOKEN=
CAPTURE_RECEIVER_TOKEN_FILE=
# Optional TLS for the receiver leg (both required together to serve HTTPS).
CAPTURE_RECEIVER_TLS_CERT=
CAPTURE_RECEIVER_TLS_KEY=

LOG_LEVEL=info
